{
  "name": "sv-repair-agent",
  "version": "0.1.0",
  "description": "TypeScript CLI that repairs SystemVerilog syntax/lint errors using Verilator and Pi Coding Agent.",
  "type": "module",
  "bin": {
    "sv-repair-agent": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "systemverilog",
    "verilator",
    "pi-coding-agent",
    "repair"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.74.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "execa": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
